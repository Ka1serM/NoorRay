<template name="inspector-object">
<head>
</head>
<body>
    <div class="empty-state" data-if="inspector.kind == ''">
        <p class="empty-title">No selection</p>
        <p class="empty-message">Click an object in the viewport or in the object list.</p>
    </div>

    <div class="attr-section" data-if="inspector.kind != ''">
        <div class="attr-heading"><span>Basic</span><div class="attr-rule"></div></div>
        <div class="attr-row"><p class="attr-label">Name</p><div class="attr-control"><div class="input"><span class="input-value clip">{{ inspector.name }}</span></div></div></div>
        <div class="attr-row"><p class="attr-label">Type</p><div class="attr-control"><span class="text-secondary">{{ inspector.heading }}</span></div></div>
    </div>

    <div class="attr-section" data-if="inspector.kind != '' &amp;&amp; inspector.kind != 'volume'">
        <div class="attr-heading"><span>Coordinates</span><div class="attr-rule"></div></div>
        <div class="coord-grid"><div class="coord-column"><p class="coord-title">Position</p><div class="coord-row"><div class="key-dot"></div><span class="axis-label">X</span><div class="num" step="0.1"><input class="input-field" type="text" data-value="inspector.positionX" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div><div class="coord-row"><div class="key-dot"></div><span class="axis-label">Y</span><div class="num" step="0.1"><input class="input-field" type="text" data-value="inspector.positionY" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div><div class="coord-row"><div class="key-dot"></div><span class="axis-label">Z</span><div class="num" step="0.1"><input class="input-field" type="text" data-value="inspector.positionZ" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div><div class="coord-column" data-if="inspector.kind == 'instance' || inspector.kind == 'gaussians' || inspector.kind == 'empty'"><p class="coord-title">Scale</p><div class="coord-row"><div class="key-dot"></div><span class="axis-label">X</span><div class="num" step="0.1" speed="0.01"><input class="input-field" type="text" data-value="inspector.scaleX" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div><div class="coord-row"><div class="key-dot"></div><span class="axis-label">Y</span><div class="num" step="0.1" speed="0.01"><input class="input-field" type="text" data-value="inspector.scaleY" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div><div class="coord-row"><div class="key-dot"></div><span class="axis-label">Z</span><div class="num" step="0.1" speed="0.01"><input class="input-field" type="text" data-value="inspector.scaleZ" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div><div class="coord-column"><p class="coord-title">Rotation</p><div class="coord-row"><div class="key-dot"></div><span class="axis-label">X</span><div class="num" step="1" speed="0.5"><input class="input-field" type="text" data-value="inspector.rotationX" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div><div class="coord-row"><div class="key-dot"></div><span class="axis-label">Y</span><div class="num" step="1" speed="0.5"><input class="input-field" type="text" data-value="inspector.rotationY" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div><div class="coord-row"><div class="key-dot"></div><span class="axis-label">Z</span><div class="num" step="1" speed="0.5"><input class="input-field" type="text" data-value="inspector.rotationZ" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div></div>
    </div>

    <div class="attr-section" data-if="inspector.kind == 'instance'">
        <div class="attr-heading"><span>Mesh</span><div class="attr-rule"></div></div>
        <div class="attr-row"><p class="attr-label">Mesh</p><div class="attr-control"><span class="text-secondary clip">{{ inspector.meshName }}</span></div></div>
        <div class="attr-row"><p class="attr-label">Triangles</p><div class="attr-control"><span class="text-secondary clip">{{ inspector.triangles }}</span></div></div>
        <div class="attr-row"><p class="attr-label">Vertices</p><div class="attr-control"><span class="text-secondary clip">{{ inspector.vertices }}</span></div></div>
        <div class="attr-row"><p class="attr-label"></p><label class="toggle"><input type="checkbox" data-checked="inspector.visible" data-event-change="inspectorApply()"/><span class="toggle-knob"></span><span>Visible</span></label></div>
        <div class="attr-row"><p class="attr-label"></p><label class="toggle"><input type="checkbox" data-checked="inspector.doubleSided" data-event-change="inspectorApply()"/><span class="toggle-knob"></span><span>Double sided</span></label></div>
        <div class="attr-row"><p class="attr-label"></p><label class="toggle"><input type="checkbox" data-checked="inspector.castsShadows" data-event-change="inspectorApply()"/><span class="toggle-knob"></span><span>Casts shadows</span></label></div>
        <div class="attr-row"><p class="attr-label"></p><label class="toggle"><input type="checkbox" data-checked="inspector.cameraVisible" data-event-change="inspectorApply()"/><span class="toggle-knob"></span><span>Visible to the camera</span></label></div>
    </div>

    <div class="attr-section" data-if="inspector.kind == 'instance'">
        <div class="attr-heading"><span>Material</span><div class="attr-rule"></div></div>
        <div class="attr-row" data-for="link : inspector.materials"><p class="attr-label">{{ link.label }}</p><div class="attr-control"><button class="material-link" data-if="link.sceneIndex &gt;= 0" tooltip="Edit the material" data-event-click="materialOpen(link.sceneIndex)"><materialpreview class="preview-sphere material-tag" data-attr-material="link.sceneIndex"></materialpreview><span class="clip">{{ link.name }}</span></button><div class="material-link empty" data-if="link.sceneIndex &lt; 0" tooltip="Empty slot: drop a material on the object in the outliner"><div class="material-tag empty"></div><span class="clip">Empty</span></div></div></div>
        <div class="attr-row" data-if="inspector.materialOverride"><p class="attr-label"></p><button class="button wide" data-event-click="outlinerClearMaterial()"><span>Use the mesh materials</span></button></div>
        <p class="attr-hint" data-if="!inspector.materialOverride">Drag a material from the material manager onto the object to give it its own material.</p>
    </div>

    <div class="attr-section" data-if="inspector.kind == 'light'">
        <div class="attr-heading"><span>Light</span><div class="attr-rule"></div></div>
        <div class="attr-row"><p class="attr-label">Type</p><div class="attr-control"><select data-value="inspector.lightType" data-event-change="inspectorApply()"><option value="point">Point</option><option value="spot">Spot</option><option value="rect">Rectangle</option><option value="disk">Disk</option><option value="sphere">Sphere</option><option value="directional">Directional</option></select></div></div>
        <div class="attr-row"><p class="attr-label">Color</p><div class="attr-control"><div class="swatch-button color-field" data-class-open="inspector.colorOpen" tooltip="Pick a colour" data-event-click="inspector.colorOpen = !inspector.colorOpen"><div class="swatch" data-style-background-color="inspector.color"></div><span class="swatch-hex">{{ inspector.color }}</span><svg class="swatch-arrow" src="/UI/Icons/combo.svg"/></div></div></div>
        <div class="attr-row picker-row" data-if="inspector.colorOpen"><color-picker data-value="inspector.color" data-event-change="inspectorColor()"></color-picker></div>
        <div class="attr-row"><p class="attr-label">Power</p><div class="attr-control"><div class="num" step="1" min="0" speed="0.05"><input class="input-field" type="text" data-value="inspector.power" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row" data-if="inspector.lightType == 'point' || inspector.lightType == 'spot' || inspector.lightType == 'disk' || inspector.lightType == 'sphere'"><p class="attr-label">Radius</p><div class="attr-control"><div class="num" step="0.01" min="0"><input class="input-field" type="text" data-value="inspector.radius" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row" data-if="inspector.lightType == 'rect'"><p class="attr-label">Size</p><div class="attr-control"><div class="vector-row"><div class="num" step="0.1" min="0"><input class="input-field" type="text" data-value="inspector.width" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div><div class="num" step="0.1" min="0"><input class="input-field" type="text" data-value="inspector.height" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div></div>
        <div class="attr-row" data-if="inspector.lightType == 'spot'"><p class="attr-label">Cone angle</p><div class="attr-control"><div class="num" step="1" min="0" max="180" speed="0.25"><input class="input-field" type="text" data-value="inspector.spotAngle" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row" data-if="inspector.lightType == 'spot'"><p class="attr-label">Cone blend</p><div class="attr-control"><div class="num" step="0.05" min="0" max="1"><input class="input-field" type="text" data-value="inspector.spotBlend" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row" data-if="inspector.lightType == 'directional'"><p class="attr-label">Angular size</p><div class="attr-control"><div class="num" step="0.1" min="0" max="180"><input class="input-field" type="text" data-value="inspector.angle" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
    </div>

    <div class="attr-section" data-if="inspector.kind == 'camera'">
        <div class="attr-heading"><span>Camera</span><div class="attr-rule"></div></div>
        <div class="attr-row" data-if="!inspector.activeCamera"><p class="attr-label"></p><button class="button wide" data-event-click="inspectorMakeActiveCamera()"><svg class="icon-14 keep" src="/UI/Icons/object-camera.svg"/><span>Look through this camera</span></button></div>
        <div class="attr-row"><p class="attr-label">Projection</p><div class="attr-control"><select data-value="inspector.cameraType" data-event-change="inspectorApply()"><option value="perspective">Perspective</option><option value="orthographic">Orthographic</option><option value="fisheye">Fisheye</option><option value="realistic">Lens system</option></select></div></div>
        <div class="attr-row" data-if="inspector.cameraType == 'perspective' || inspector.cameraType == 'fisheye'"><p class="attr-label">Field of view</p><div class="attr-control"><div class="num" step="1" min="1" max="179" speed="0.25"><input class="input-field" type="text" data-value="inspector.fieldOfView" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row" data-if="inspector.cameraType == 'orthographic'"><p class="attr-label">Height</p><div class="attr-control"><div class="num" step="0.1" min="0"><input class="input-field" type="text" data-value="inspector.orthographicHeight" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row" data-if="inspector.cameraType != 'orthographic'"><p class="attr-label">Focus distance</p><div class="attr-control"><div class="num" step="0.1" min="0"><input class="input-field" type="text" data-value="inspector.focusDistance" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row" data-if="inspector.cameraType != 'orthographic'"><p class="attr-label">F-stop</p><div class="attr-control"><div class="num" step="0.1" min="0"><input class="input-field" type="text" data-value="inspector.fStop" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row" data-if="inspector.cameraType != 'orthographic'"><p class="attr-label">Aperture blades</p><div class="attr-control"><div class="num" step="1" min="0" max="16" speed="0.1" integer><input class="input-field" type="text" data-value="inspector.blades" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row"><p class="attr-label">Sensor (mm)</p><div class="attr-control"><div class="vector-row"><div class="num" step="1" min="1"><input class="input-field" type="text" data-value="inspector.sensorWidth" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div><div class="num" step="1" min="1"><input class="input-field" type="text" data-value="inspector.sensorHeight" data-event-change="inspectorApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div></div>
        <div class="attr-row" data-if="inspector.cameraType == 'realistic'"><p class="attr-label">Lens elements</p><div class="attr-control"><span class="text-secondary">{{ inspector.lensElements }}</span></div></div>
    </div>

    <div class="attr-section" data-if="inspector.kind == 'gaussians'">
        <div class="attr-heading"><span>Gaussians</span><div class="attr-rule"></div></div>
        <div class="attr-row"><p class="attr-label">Count</p><div class="attr-control"><span class="text-secondary clip">{{ inspector.gaussianCount }}</span></div></div>
        <div class="attr-row"><p class="attr-label">SH degree</p><div class="attr-control"><span class="text-secondary clip">{{ inspector.shDegree }}</span></div></div>
    </div>
</body>
</template>
