    {
      "name": "blender-addon",
      "displayName": "Blender Addon",
      "description": "The Blender extension zip for Linux and Windows. It builds the windows-release module too.",
      "configurePreset": "linux-release",
      "targets": [
        "NoorRay.Blender.Zip"
      ]
    }
