[
  {
    "label": "clean build",
    "command": "rm -rf build",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "configure debug",
    "command": "VULKAN_SDK=/home/marcel/Programs/VulkanSDK/current cmake -S . -B build/debug -DNR_CUDA_ROOT=/usr/local/cuda -DOPTIX_ROOT=/home/marcel/Programs/OptixSDK -DCMAKE_C_COMPILER=/usr/bin/gcc-15 -DCMAKE_CXX_COMPILER=/usr/bin/g++-15 -DCMAKE_CUDA_HOST_COMPILER=/usr/bin/g++-15 -DPython_EXECUTABLE=$ZED_WORKTREE_ROOT/.venv/bin/python -DCMAKE_BUILD_TYPE=Debug -DNR_CUDA_ARCH='86;89' -DNR_BUILD_PYTHON=ON -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "configure release",
    "command": "VULKAN_SDK=/home/marcel/Programs/VulkanSDK/current cmake -S . -B build/release -DNR_CUDA_ROOT=/usr/local/cuda -DOPTIX_ROOT=/home/marcel/Programs/OptixSDK -DCMAKE_C_COMPILER=/usr/bin/gcc-15 -DCMAKE_CXX_COMPILER=/usr/bin/g++-15 -DCMAKE_CUDA_HOST_COMPILER=/usr/bin/g++-15 -DPython_EXECUTABLE=$ZED_WORKTREE_ROOT/.venv/bin/python -DCMAKE_BUILD_TYPE=Release -DNR_CUDA_ARCH='86;89' -DNR_BUILD_PYTHON=ON -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "build libnoorray Debug",
    "command": "cmake --build build/debug --target libnoorray -j$(nproc)",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "build libnoorray Release",
    "command": "cmake --build build/release --target libnoorray -j$(nproc)",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "build NoorRay Debug",
    "command": "cmake --build build/debug --target NoorRay -j$(nproc)",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "build NoorRay Release",
    "command": "cmake --build build/release --target NoorRay -j$(nproc)",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "build pynoorray Release",
    "command": "cmake --build build/release --target _pynoorray -j$(nproc)",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "run NoorRay Debug",
    "command": "cmake --build build/debug --target NoorRay -j$(nproc) && ./build/debug/NoorRay",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "run NoorRay Release",
    "command": "cmake --build build/release --target NoorRay -j$(nproc) && ./build/release/NoorRay",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "run pynoorray Release",
    "command": "PYTHONPATH=$ZED_WORKTREE_ROOT/build/release/lib $ZED_WORKTREE_ROOT/.venv/bin/python $ZED_WORKTREE_ROOT/src/pynoorray/examples/pynoorray_render.py",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  }
]
