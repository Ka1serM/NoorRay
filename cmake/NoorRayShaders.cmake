include_guard(GLOBAL)

#! The bit order is the order of NoorRay::Render::LinkConstant.
set(NOORRAY_LINK_CONSTANTS hasGaussians hasVolumes hasDispersion hasAlphaTest litGaussians hasSubsurface CACHE INTERNAL "")
cmake_path(SET NOORRAY_SHADER_DIR NORMALIZE "${CMAKE_CURRENT_LIST_DIR}/../src/NoorRay/Shaders")

#! KERNELS takes Name:constant,constant items: Entries/Name.slang has the [shader] wrappers of one entry point called name, and each subset of the constants gets a variant.
function(noorray_add_shaders target)
    cmake_parse_arguments(PARSE_ARGV 1 shaders "RAY_QUERIES" "" "KERNELS;SOURCES;INCLUDES")
    if(shaders_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "noorray_add_shaders: unknown arguments ${shaders_UNPARSED_ARGUMENTS}")
    endif()
    list(LENGTH NOORRAY_LINK_CONSTANTS constant_count)
    math(EXPR mask_count "1 << ${constant_count}")
    math(EXPR last_mask "${mask_count} - 1")
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/${target}Entries")
    set(sources ${shaders_SOURCES})
    set(includes "")
    set(tables "")
    foreach(kernel IN LISTS shaders_KERNELS)
        string(REPLACE ":" ";" parts "${kernel}")
        list(GET parts 0 name)
        set(constants "")
        list(LENGTH parts part_count)
        if(part_count GREATER 1)
            list(GET parts 1 constants)
            string(REPLACE "," ";" constants "${constants}")
        endif()
        if(NOT NOORRAY_GAUSSIAN_TRACING)
            list(REMOVE_ITEM constants hasGaussians litGaussians)
        endif()
        set(entry "${NOORRAY_SHADER_DIR}/Entries/${name}.slang")
        if(NOT EXISTS "${entry}")
            message(FATAL_ERROR "noorray_add_shaders: ${entry} does not exist")
        endif()
        #! The variants copy the entry text, because noorrhi_add_shaders finds the ray tracing stages in the text of a source.
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${entry}")
        file(READ "${entry}" entry_text)
        set(used 0)
        foreach(constant IN LISTS constants)
            list(FIND NOORRAY_LINK_CONSTANTS "${constant}" bit)
            if(bit LESS 0)
                message(FATAL_ERROR "noorray_add_shaders: ${name} uses the unknown link constant ${constant}")
            endif()
            math(EXPR used "${used} | (1 << ${bit})")
        endforeach()
        string(SUBSTRING "${name}" 0 1 first)
        string(TOLOWER "${first}" first)
        string(SUBSTRING "${name}" 1 -1 rest)
        set(function "${first}${rest}")
        set(pointers "")
        foreach(mask RANGE ${last_mask})
            math(EXPR variant "${mask} & ${used}")
            string(APPEND pointers "&${name}V${variant}::${function}, ")
            if(NOT mask EQUAL variant)
                continue()
            endif()
            set(content "")
            set(index 0)
            foreach(constant IN LISTS NOORRAY_LINK_CONSTANTS)
                math(EXPR bit "(${variant} >> ${index}) & 1")
                set(value false)
                if(bit)
                    set(value true)
                endif()
                string(APPEND content "export static const bool ${constant} = ${value};\n")
                math(EXPR index "${index} + 1")
            endforeach()
            string(APPEND content "#line 1 \"${entry}\"\n${entry_text}")
            file(CONFIGURE OUTPUT "${generated}/${name}V${variant}.slang" CONTENT "${content}" @ONLY)
            list(APPEND sources "${generated}/${name}V${variant}.slang")
            string(APPEND includes "#include \"${name}V${variant}.slang.h\"\n")
        endforeach()
        string(REGEX REPLACE ", $" "" pointers "${pointers}")
        string(APPEND tables "inline constexpr std::uint32_t ${function}Constants = ${used};\n")
        string(APPEND tables "inline const std::array<const NoorRHI::Shader*, ${mask_count}> ${function}{${pointers}};\n")
    endforeach()

    set(options "")
    if(shaders_RAY_QUERIES)
        list(APPEND options RAY_QUERIES)
    endif()
    noorrhi_add_shaders(${target} ${options} ${sources} INCLUDES "${NOORRAY_SHADER_DIR}" "${PROJECT_SOURCE_DIR}/src" ${shaders_INCLUDES})
    file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/${target}/${target}Variants.h" CONTENT "\
//! Generated by noorray_add_shaders: each table is indexed by the link constant mask.
#pragma once

#include <array>
#include <cstdint>

#include \"NoorRHI/Pipelines/Pipeline.h\"
${includes}
namespace NoorRay::Shaders {

${tables}
}
" @ONLY)
endfunction()

#! Writes one entry file per NRD pass into the shader list sources_var and the identifier table header NrdShaders.h of target. PASSES takes Name:File:DEFINE=VALUE,DEFINE=VALUE items in the order of the identifiers that nrd::Instance builds.
function(noorray_nrd_entries target sources_var)
    cmake_parse_arguments(PARSE_ARGV 2 nrd "" "" "PASSES")
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/${target}Nrd")
    set(sources "")
    set(includes "")
    set(rows "")
    set(count 0)
    foreach(pass IN LISTS nrd_PASSES)
        string(REPLACE ":" ";" parts "${pass}")
        list(GET parts 0 name)
        list(GET parts 1 file)
        set(defines "")
        list(LENGTH parts part_count)
        if(part_count GREATER 2)
            list(GET parts 2 defines)
            string(REPLACE "," ";" defines "${defines}")
        endif()
        string(SUBSTRING "${name}" 0 1 first)
        string(TOLOWER "${first}" first)
        string(SUBSTRING "${name}" 1 -1 rest)
        set(function "${first}${rest}")
        set(identifier "${file}.cs.hlsl")
        set(content "")
        foreach(define IN LISTS defines)
            string(REPLACE "=" " " spaced "${define}")
            string(APPEND content "#define ${spaced}\n")
            string(APPEND identifier "|${define}")
        endforeach()
        if(file MATCHES "^RELAX_")
            string(APPEND content "#define NRD_PASS_CONFIG \"RELAX_Config.hlsli\"\n")
        endif()
        string(APPEND content "#define NRD_CS_MAIN ${function}\n#define NRD_PASS_RESOURCES \"${file}.resources.hlsli\"\n#define NRD_PASS_SOURCE \"${file}.cs.hlsl\"\n")
        string(APPEND content "#include \"Denoise/NrdPass.slang\"\n")
        file(CONFIGURE OUTPUT "${generated}/${name}.slang" CONTENT "${content}" @ONLY)
        list(APPEND sources "${generated}/${name}.slang")
        string(APPEND includes "#include \"${name}.slang.h\"\n")
        string(APPEND rows "    NrdShader{\"${identifier}\", &${name}::${function}},\n")
        math(EXPR count "${count} + 1")
    endforeach()
    file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/${target}/NrdShaders.h" CONTENT "\
//! Generated by noorray_nrd_entries: the NoorRay shader of each NRD shader identifier.
#pragma once

#include <array>
#include <string_view>

#include \"NoorRHI/Pipelines/Pipeline.h\"
${includes}
namespace NoorRay::Shaders {

struct NrdShader {
    std::string_view identifier;
    const NoorRHI::Shader* shader;
};

inline const std::array<NrdShader, ${count}> nrdShaders{{
${rows}}};

}
" @ONLY)
    set(${sources_var} ${sources} PARENT_SCOPE)
endfunction()
