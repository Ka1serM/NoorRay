/* Body setup */
body {
    font-family: Inter;
    font-size: 18px;
    color: #02475e;
    background: #fefecc;
    text-align: center;
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    position: relative;
}

/* Header area */
#header {
    width: 100%;
    padding: 2em 1em;
    box-sizing: border-box;
}

/* Headings */
h1 {
    color: #f6470a;
    font-size: 2.5em;
    font-weight: bold;
    margin-bottom: 0.7em;
}

p { 
    margin: 0.7em 0;
    font-size: 1.2em;
}

/* Input text box */
input.text {
    background-color: #fff;
    color: #555;
    border: 2px solid #999;
    padding: 5px;
    cursor: text;
    box-sizing: border-box;
    width: 200px;
    font-size: 0.9em;
}

/* Viewport styling */
#viewport {
    position: absolute;        /* float above other content */
    top: 50%;                  /* center vertically */
    left: 50%;                 /* center horizontally */
    transform: translate(-50%, -50%);
    width: 800px;
    height: 600px;
    background-color: #222;
    border: 2px solid #888;
    z-index: 100;              /* ensure it’s above other elements */
}
