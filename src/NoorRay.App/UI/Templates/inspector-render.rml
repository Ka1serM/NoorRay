<template name="inspector-render">
<head>
</head>
<body>
    <div class="attr-section">
        <div class="attr-heading"><span>Mode</span><div class="attr-rule"></div></div>
        <div class="attr-row"><p class="attr-label">Renderer</p><div class="attr-control"><div class="segment"><button class="segment-item" data-class-on="renderSettings.mode == 'raster'" data-event-click="renderSettings.mode = 'raster'; renderMode()"><span>Raster</span></button><button class="segment-item" data-class-on="renderSettings.mode == 'pathTraced'" data-event-click="renderSettings.mode = 'pathTraced'; renderMode()"><span>Path traced</span></button></div></div></div>
        <div class="attr-row" data-if="renderSettings.mode == 'raster'"><p class="attr-label"></p><p class="attr-note">The first hit with direct light and the environment, without shadows or bounces. Fast, for editing.</p></div>
        <div class="attr-row" data-if="renderSettings.mode == 'pathTraced'"><p class="attr-label">Camera rays</p><div class="attr-control"><div class="segment"><button class="segment-item" data-class-on="renderSettings.tracedCameraRays == false" data-event-click="renderSettings.tracedCameraRays = false; renderApply()"><span>Rasterized</span></button><button class="segment-item" data-class-on="renderSettings.tracedCameraRays == true" data-event-click="renderSettings.tracedCameraRays = true; renderApply()"><span>Traced</span></button></div></div></div>
        <div class="attr-row" data-if="renderSettings.mode == 'pathTraced'"><p class="attr-label">Path reuse</p><div class="attr-control"><div class="segment"><button class="segment-item" data-class-on="renderSettings.pathReuse == false" data-event-click="renderSettings.pathReuse = false; renderApply()"><span>Off</span></button><button class="segment-item" data-class-on="renderSettings.pathReuse == true" data-event-click="renderSettings.pathReuse = true; renderApply()"><span>ReSTIR PT</span></button></div></div></div>
        <div class="attr-row" data-if="renderSettings.mode == 'pathTraced'"><p class="attr-label"></p><p class="attr-note">Rasterized camera rays are faster but softer at edges. A camera with depth of field, a lens or path reuse always traces them.</p></div>
    </div>

    <div class="attr-section">
        <div class="attr-heading"><span>Sampling</span><div class="attr-rule"></div></div>
        <div class="attr-row"><p class="attr-label"></p><label class="toggle"><input type="checkbox" data-checked="renderSettings.accumulate" data-event-change="renderApply()"/><span class="toggle-knob"></span><span>Accumulate samples</span></label></div>
        <div class="attr-row" data-if="renderSettings.accumulate"><p class="attr-label">Sample limit</p><div class="attr-control"><div class="num" step="16" min="0" speed="1" integer><input class="input-field" type="text" data-value="renderSettings.maxSamples" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row" data-if="renderSettings.accumulate"><p class="attr-label"></p><p class="attr-note">0 has no limit.</p></div>
    </div>

    <div class="attr-section" data-if="renderSettings.mode == 'pathTraced'">
        <div class="attr-heading"><span>Light paths</span><div class="attr-rule"></div></div>
        <div class="attr-row"><p class="attr-label">Maximum depth</p><div class="attr-control"><div class="num" step="1" min="1" max="256" speed="0.1" integer><input class="input-field" type="text" data-value="renderSettings.maxDepth" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row"><p class="attr-label">Roulette start</p><div class="attr-control"><div class="num" step="1" min="0" max="256" speed="0.1" integer><input class="input-field" type="text" data-value="renderSettings.rouletteStart" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row"><p class="attr-label">Indirect clamp</p><div class="attr-control"><div class="num" step="0.5" min="0"><input class="input-field" type="text" data-value="renderSettings.indirectClamp" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row"><p class="attr-label"></p><p class="attr-note">A clamp of 0 is off.</p></div>
        <div class="attr-row"><p class="attr-label">Gaussians</p><div class="attr-control"><select data-value="renderSettings.gaussianShading" data-event-change="renderSettings.gaussianShading = ev.value; renderApply()"><option value="emissive">Emissive</option><option value="scattering">Scattering</option></select></div></div>
    </div>

    <div class="attr-section">
        <div class="attr-heading"><span>Display</span><div class="attr-rule"></div></div>
        <div class="attr-row"><p class="attr-label">Tone mapping</p><div class="attr-control"><div class="segment"><button class="segment-item" data-class-on="renderSettings.toneMapping == 'linear'" data-event-click="renderSettings.toneMapping = 'linear'; renderApply()"><span>Linear</span></button><button class="segment-item" data-class-on="renderSettings.toneMapping == 'neutral'" data-event-click="renderSettings.toneMapping = 'neutral'; renderApply()"><span>Neutral</span></button><button class="segment-item" data-class-on="renderSettings.toneMapping == 'agx'" data-event-click="renderSettings.toneMapping = 'agx'; renderApply()"><span>AgX</span></button></div></div></div>
        <div class="attr-row"><p class="attr-label">Exposure</p><div class="attr-control"><div class="num" step="0.1" speed="0.02"><input class="input-field" type="text" data-value="renderSettings.exposure" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div><span class="num-unit">EV</span></div></div>
        <div class="attr-row"><p class="attr-label">Moving pixels</p><div class="attr-control"><div class="segment"><button class="segment-item" data-class-on="renderSettings.motionDivisor == 1" data-event-click="renderSettings.motionDivisor = 1; renderApply()"><span>Off</span></button><button class="segment-item" data-class-on="renderSettings.motionDivisor == 2" data-event-click="renderSettings.motionDivisor = 2; renderApply()"><span>1/2</span></button><button class="segment-item" data-class-on="renderSettings.motionDivisor == 4" data-event-click="renderSettings.motionDivisor = 4; renderApply()"><span>1/4</span></button></div></div></div>
        <div class="attr-row"><p class="attr-label"></p><p class="attr-note">The viewport renders at this resolution while the camera moves.</p></div>
        <div class="attr-row"><p class="attr-label"></p><button class="button wide" data-event-click="renderRestart()"><svg class="icon-14" src="/UI/Icons/restart.svg"/><span>Restart accumulation</span></button></div>
    </div>
</body>
</template>
