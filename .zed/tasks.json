[
  {
    "label": "clean build",
    "command": "rm -rf build",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "configure debug",
    "command": "VULKAN_SDK=/home/marcel/Programs/VulkanSDK/current cmake -S . -B build/debug -DCMAKE_CXX_COMPILER=/usr/bin/g++-15 -DVulkan_LIBRARY=/home/marcel/Programs/VulkanSDK/current/lib/VulkanLoader/lib/libvulkan.so -DPython_EXECUTABLE=$ZED_WORKTREE_ROOT/.venv/bin/python -DCMAKE_BUILD_TYPE=RelWithDebInfo -DNR_BUILD_PYTHON=ON -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "configure release",
    "command": "VULKAN_SDK=/home/marcel/Programs/VulkanSDK/current cmake -S . -B build/release -DCMAKE_CXX_COMPILER=/usr/bin/g++-15 -DVulkan_LIBRARY=/home/marcel/Programs/VulkanSDK/current/lib/VulkanLoader/lib/libvulkan.so -DPython_EXECUTABLE=/usr/bin/python3.13 -DCMAKE_BUILD_TYPE=Release -DNR_BUILD_PYTHON=ON -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "build libnoorray Debug",
    "command": "VULKAN_SDK=/home/marcel/Programs/VulkanSDK/current cmake --build build/debug --target libnoorray -j$(nproc)",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "build libnoorray Release",
    "command": "VULKAN_SDK=/home/marcel/Programs/VulkanSDK/current cmake --build build/release --target libnoorray -j$(nproc)",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
