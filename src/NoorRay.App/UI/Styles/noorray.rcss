/*! The NoorRay workspace after the Cinema 4D redesign in Figma: a mode strip, the viewport with its timeline, the transport and material manager below it, the object and attribute manager on the right, and two floating panels. */

.workspace { position: relative; display: flex; height: 100%; padding: 0 16dp 16dp 0; box-sizing: border-box; }

/*! The panels are split by handles that are gaps until the mouse is on them. */
splitter { display: block; flex: 0 0 auto; drag: drag; border-radius: 3dp; }

splitter.vertical { width: 4dp; margin: 0 3dp; cursor: ew-resize; }

splitter.horizontal { height: 4dp; margin: 3dp 0; cursor: ns-resize; }

splitter:hover, splitter:active { background-color: #fafafa14; }

/*! Mode strip */

.mode-strip { flex: 0 0 auto; display: flex; flex-direction: column; align-items: center; gap: 6dp; width: 62dp; padding: 0 2dp 0 6dp; box-sizing: border-box; }

/*! Every mode keeps a transparent border, so the border of the chosen one does not move the strip. */
.mode { display: flex; align-items: center; justify-content: center; width: 45dp; height: 45dp; box-sizing: border-box; border-width: 1dp; border-color: transparent; border-radius: 12dp; }

.mode svg { width: 24dp; height: 24dp; opacity: 0.5; }

.mode.first { margin-bottom: 16dp; }

.mode.first svg { width: 26dp; height: 26dp; }

.mode:hover { background-color: #fafafa08; }

.mode:hover svg { opacity: 0.8; }

.glow-make { filter: drop-shadow(#fafafa4d 0 0 4dp); }

.glow-model { filter: drop-shadow(#fafafa40 0 0 10dp); }

.glow-points { filter: drop-shadow(#fafafa80 0 0 5dp); }

.glow-edges { filter: drop-shadow(#fafafa40 0 0 3dp); }

.glow-polys { filter: drop-shadow(#fafafa59 0 0 8dp); }

.mode.on { background-color: #1d1d1d; border-color: #ffffff17; }

.mode.on svg { opacity: 1; }

.mode-more { display: flex; gap: 8dp; margin-top: 16dp; }

.mode-more div { width: 4dp; height: 4dp; border-radius: 2dp; background-color: #fafafa26; }

/*! Centre column */

.center-column { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; }

.viewport-panel { position: relative; flex: 1 1 0; min-height: 0; border-radius: 14dp; background-color: #0a0a0a; }

.viewport-body { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 14dp; overflow: hidden; }

.scene-viewport { display: block; position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/*! A plugin's image in place of the scene: an amber frame and a bar with the way back */

.preview-frame { position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 14; border: 2dp #d9a441; border-radius: 14dp; pointer-events: none; }

.preview-banner { position: absolute; left: 0; right: 0; bottom: 0; z-index: 15; display: flex; align-items: center; gap: 4dp; height: 32dp; padding: 0 8dp 0 14dp; background-color: #d9a441; color: #141414; font-size: 12dp; }

.preview-text { flex: 1 1 0; min-width: 0; display: flex; align-items: center; gap: 12dp; overflow: hidden; }

.preview-title { font-weight: bold; white-space: nowrap; }

.preview-detail { color: #141414b3; white-space: nowrap; }

.preview-button { flex: 0 0 auto; display: flex; align-items: center; height: 24dp; padding: 0 10dp; border-radius: 4dp; color: #141414; cursor: pointer; }

.preview-button:hover { background-color: #00000026; }

.preview-button.disabled { color: #14141473; pointer-events: none; }

.view-menu { position: absolute; left: 16dp; top: 16dp; z-index: 15; display: flex; align-items: center; gap: 12dp; }

.view-pill { display: flex; align-items: center; height: 32dp; padding: 0 12dp; border-radius: 8dp; background-color: #fafafa1f; backdrop-filter: blur(12dp); font-size: 12dp; color: #fafafa; }

.view-bar { height: 32dp; padding: 0 8dp 0 12dp; border-radius: 8dp; background-color: #0f0f0fb3; backdrop-filter: blur(12dp); gap: 4dp; }

.view-bar .grip { margin-right: 8dp; }

.view-status { position: absolute; top: 24dp; right: 24dp; display: flex; align-items: center; gap: 16dp; font-size: 11dp; color: #fafafa73; pointer-events: none; }

.view-status .link { pointer-events: auto; }

.view-status .status-item { display: flex; align-items: center; gap: 8dp; }

.axis-corner { position: absolute; left: 70dp; bottom: 92dp; width: 47dp; height: 60dp; pointer-events: none; }

.axis-corner svg { width: 47dp; height: 60dp; }

.fold { flex: 0 0 auto; width: 6dp; height: 14dp; decorator: svg(/UI/Icons/fold.svg); }

.fold.dark { opacity: 0.8; }

.grip { flex: 0 0 auto; width: 10dp; height: 10dp; decorator: svg(/UI/Icons/grip.svg); }

/*! The timeline under the viewport: current frame, frame ruler, range, transport and frame rate */

.transport { flex: 0 0 auto; display: flex; align-items: center; gap: 8dp; height: 32dp; margin: 8dp 0 0 0; padding: 0 8dp 0 16dp; overflow: hidden; }

/*! A narrow transport drops the range labels and the first and last frame buttons, so the ruler keeps its space. */
.transport.narrow .timeline-field-label, .transport.narrow .play-button.edge { display: none; }

.transport > .fold { margin-right: 4dp; }

.timeline-field { position: relative; flex: 0 0 auto; display: flex; align-items: center; gap: 6dp; }

.timeline-field .num { flex: 0 0 auto; width: 58dp; height: 28dp; }

.timeline-field.current .num { width: 64dp; }

.timeline-field.current .input-field { color: #fafafa; }

.timeline-field.fps .num { width: 72dp; }

.timeline-field-label { font-size: 11dp; color: #fafafa59; }

.timeline-strip { flex: 1 1 0; min-width: 0; height: 32dp; padding: 0 12dp; box-sizing: border-box; border-radius: 6dp; background-color: #0f0f0f; }

.timeline-ruler { position: relative; height: 100%; cursor: pointer; }

.timeline-tick { position: absolute; top: 0; bottom: 0; width: 0; }

.timeline-tick-mark { position: absolute; left: 0; bottom: 0; width: 1dp; height: 5dp; background-color: #fafafa2e; }

.timeline-tick.major .timeline-tick-mark { height: 9dp; background-color: #fafafa73; }

.timeline-tick-label { position: absolute; left: -24dp; top: 4dp; width: 48dp; text-align: center; font-size: 11dp; color: #fafafa8c; }

.timeline-playhead { position: absolute; top: 0; bottom: 0; width: 0; pointer-events: none; }

.timeline-playhead-cap { position: absolute; left: -4dp; top: 0; width: 8dp; height: 5dp; border-radius: 0 0 2dp 2dp; background-color: #fafafa; }

.timeline-playhead-line { position: absolute; left: -1dp; top: 0; bottom: 0; width: 2dp; background-color: #fafafa; box-shadow: #ffffff17 0 0 10dp 0; }

.transport-buttons { flex: 0 0 auto; display: flex; align-items: center; gap: 4dp; }

.play-button { display: flex; align-items: center; justify-content: center; width: 24dp; height: 24dp; }

.play-button svg { width: 16dp; height: 16dp; }

.play-button svg { image-color: #fafafab3; }

.play-button:hover svg { image-color: #fafafa; }

.play-button.play { width: 28dp; height: 28dp; border-radius: 14dp; background-color: #ffffff0d; }

.play-button.play svg { width: 16dp; height: 16dp; image-color: #fafafa; }

.play-button.play:hover { background-color: #ffffff1f; }

/*! Material manager */

.bottom-panel { flex: 0 0 180dp; min-height: 0; display: flex; flex-direction: column; }

.material-manager { flex: 1 1 0; min-height: 0; display: flex; flex-direction: column; gap: 12dp; padding-left: 16dp; overflow: hidden; }

.small-menu { display: flex; align-items: center; gap: 4dp; height: 24dp; }

.small-menu > .fold, .small-menu > .grip { margin-right: 12dp; }

.small-menu .menu-title { height: 24dp; padding: 0 8dp; font-size: 12dp; }

.material-tiles { display: block; flex: 1 1 0; min-height: 0; padding-right: 12dp; overflow-y: auto; }

/*! The drawer is a virtual grid; its rows are 84dp tiles plus the 8dp gap of the GridLayout in SceneController. */

.material-tiles .grid-row { display: flex; gap: 8dp; align-items: flex-start; padding-bottom: 8dp; }

.material-tiles .grid-item { flex: 1 1 0; min-width: 0; }

.material-tiles .grid-filler { flex: 0 1 0; }

.material-tile { display: flex; flex-direction: column; align-items: center; gap: 8dp; height: 84dp; padding-top: 12dp; box-sizing: border-box; border-width: 1dp; border-color: #ffffff0f; border-radius: 8dp; background-color: #0f0f0f; font-size: 11dp; color: #a1a1a1; }

/*! The name spans the tile, so the ellipsis cuts it at the tile edge and not after its first letter. */
.material-tile span { align-self: stretch; padding: 0 8dp; box-sizing: border-box; text-align: center; }

.material-tile { drag: clone; }

/*! The drag clone shows only the material ball. */
.material-tile:drag, .material-tile:drag:hover, .material-tile.selected:drag, .material-tile.editing:drag { border-color: transparent; background-color: transparent; }

.material-tile:drag span { display: none; }

.material-tile:hover { background-color: #ffffff0d; color: #fafafa; }

.material-tile.editing { border-color: #ffffff17; }

.material-tile.selected { background-color: #1d1d1d; border-color: #ffffff17; color: #fafafa; }

.tiles-empty { font-size: 11dp; color: #fafafa4d; padding-top: 8dp; }

.preview-sphere { flex: 0 0 auto; width: 40dp; height: 40dp; border-radius: 20dp; }

.preview-sphere.large { width: 96dp; height: 96dp; border-radius: 48dp; }

materialpreview { display: block; }

/*! Node editor window: the graph on the left and the parameter pane of the active node on the right. */

.node-editor-body { flex: 1 1 0; min-height: 0; display: flex; padding: 12dp; }

.node-graph-area { position: relative; flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 8dp; }

.node-path { position: relative; flex: 0 1 auto; min-width: 0; display: flex; align-items: center; gap: 2dp; }

.node-path-step { display: flex; align-items: center; gap: 2dp; min-width: 0; }

.node-path-arrow { flex: 0 0 auto; width: 8dp; height: 8dp; image-color: #fafafa4d; }

.node-crumb { flex: 0 1 auto; min-width: 0; max-width: 260dp; display: flex; align-items: center; height: 28dp; padding: 0 8dp; border-radius: 6dp; font-size: 13dp; color: #fafafa80; }

.node-crumb:hover { background-color: #ffffff0d; color: #fafafa; }

.node-crumb.on { color: #fafafa; }

.node-tools { position: relative; flex: 0 0 auto; display: flex; align-items: center; gap: 4dp; margin-left: auto; }

.node-tool { display: flex; align-items: center; gap: 6dp; height: 28dp; min-width: 28dp; padding: 0 7dp; box-sizing: border-box; border-radius: 6dp; font-size: 12dp; color: #fafafab3; }

.node-tool svg { width: 14dp; height: 14dp; image-color: #fafafab3; }

.node-tool:hover { background-color: #ffffff0d; color: #fafafa; }

.node-tool:hover svg { image-color: #fafafa; }

.node-tool.disabled { opacity: 0.35; }

/*! Node graph: the canvas holds the nodes at their tree locations. <nodegraph> pans it with a whole pixel translate and zooms it with its font size (11dp at zoom 1), so every length in the canvas is in em: a length of n dp at an 11dp font is n/11 em, and at a 12dp font n/12 em. The text is then laid out and drawn at its shown size instead of being scaled. */
.node-graph { position: relative; display: block; flex: 1 1 0; min-height: 0; overflow: hidden; border-width: 1dp; border-color: #ffffff0f; border-radius: 8dp; background-color: #1d1d1d; }

.node-canvas { position: absolute; left: 0; top: 0; width: 0; height: 0; font-size: 11dp; }

.node-frame-label { position: absolute; display: flex; align-items: center; height: 2em; padding: 0 0.8333em; box-sizing: border-box; font-size: 1.0909em; color: #fafafa99; }

/*! The heights of .node-header, .node-body and .node-row are the layout constants of NodeGraphController. */
.node { position: absolute; display: block; box-sizing: border-box; border-width: 0.0909em; border-color: #000000; border-radius: 0.5455em; background-color: #303030f2; color: #e5e5e5; }

.node.selected { border-color: #ed5700; }

.node.active { border-color: #ffffff; }

.node.muted { opacity: 0.45; }

/*! Header colours are the node colours of the Blender default theme. */
.node-header { display: flex; align-items: center; gap: 0.3636em; height: 2.1818em; padding: 0 0.7273em; border-radius: 0.4545em 0.4545em 0 0; background-color: #83314a; color: #fafafa; cursor: move; }

.node.collapsed .node-header { border-radius: 0.4545em; }

.node-header span { flex: 1 1 0; min-width: 0; }

.node-group-icon { flex: 0 0 auto; width: 0.7273em; height: 0.7273em; image-color: #fafafab3; }

.node-header[category=output] { background-color: #4d0017; }

.node-header[category=shader] { background-color: #2b652b; }

.node-header[category=texture] { background-color: #79461d; }

.node-header[category=color] { background-color: #6c6c2b; }

.node-header[category=vector], .node-header[category=displacement] { background-color: #3c3c83; }

.node-header[category=converter], .node-header[category=math] { background-color: #246283; }

.node-header[category=group] { background-color: #3b5959; }

.node-header[category=layout] { background-color: #6c696f; }

.node-header[category=script] { background-color: #084d4d; }

.node-body { padding-top: 0.3636em; }

.node-row { position: relative; display: flex; align-items: center; gap: 0.5455em; height: 2em; padding: 0 0.9091em; }

.node-row.output { justify-content: flex-end; }

.node-socket { position: absolute; left: -6dp; top: 6dp; width: 10dp; height: 10dp; border-width: 1dp; border-color: #000000b3; border-radius: 5dp; }

.node-canvas .node-socket { left: -0.5455em; top: 0.5455em; width: 0.9091em; height: 0.9091em; border-width: 0.0909em; border-radius: 0.4545em; }

.node-row.output .node-socket { left: auto; right: -0.5455em; }

.node-socket:hover { border-color: #fafafa; }

.node-socket.dim { opacity: 0.25; }

.node-name { flex: 0 1 auto; min-width: 0; }

.node-text { flex: 1 1 0; min-width: 0; text-align: right; color: #a1a1a1; }

.num.node-num { height: 1.6364em; padding: 0 0.5455em; border-width: 0.0909em; border-radius: 0.3636em; background-color: #545454; border-color: #00000066; }

.num.node-num:hover { background-color: #656565; }

.node-num-label { flex: 0 1 auto; min-width: 0; margin-right: 4dp; color: #c4c4c4; pointer-events: none; }

.node-canvas .node-num-label { margin-right: 0.3636em; }

.node-num .input-field { flex: 1 1 0; min-width: 0; height: 1.3333em; line-height: 1.3333em; font-size: 1.0909em; text-align: right; }

.node-toggle { height: 2em; gap: 0.5455em; color: #e5e5e5; }

.node-toggle input { width: 1.4545em; height: 1.4545em; border-width: 0.0909em; border-radius: 0.3636em; }

.node-toggle .toggle-knob { left: 0.2727em; width: 0.9091em; height: 0.9091em; margin-top: -0.4545em; }

.node-swatch { flex: 1 1 0; height: 16dp; border-width: 1dp; border-color: #00000080; border-radius: 4dp; cursor: pointer; }

.node-canvas .node-swatch { height: 1.4545em; border-width: 0.0909em; border-radius: 0.3636em; }

.node-swatch.open { border-color: #fafafa; }

.node.reroute { border-radius: 0.5455em; border-color: #00000099; background-color: #a1a1a1; }

.node.reroute .node-header, .node.reroute .node-body { display: none; }

.node-empty { position: absolute; left: 16dp; right: 16dp; top: 50%; font-size: 12dp; text-align: center; color: #fafafa4d; pointer-events: none; }

.node-empty.use-nodes { display: flex; flex-direction: column; align-items: center; gap: 12dp; pointer-events: auto; }

.use-nodes .button { height: 28dp; padding: 0 12dp; font-size: 12dp; }

/*! The layer above the nodes that draws the dragged link, the box and the cut line. */
.node-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 5; pointer-events: none; }
/*! The add menu; its size is the menu size that NodeGraphController keeps inside the graph. */
.node-menu { position: absolute; z-index: 10; display: flex; flex-direction: column; gap: 6dp; width: 240dp; max-height: 320dp; padding: 8dp; box-sizing: border-box; border-width: 1dp; border-color: #ffffff17; border-radius: 10dp; background-color: #0f0f0ff7; font-size: 12dp; color: #fafafa; }

.node-menu-head { flex: 0 0 auto; display: flex; align-items: center; gap: 4dp; }

.node-menu-back { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 28dp; height: 28dp; border-radius: 6dp; }

.node-menu-back svg { width: 10dp; height: 10dp; image-color: #fafafab3; }

.node-menu-back:hover { background-color: #ffffff0d; }

.node-menu-field { flex: 1 1 0; min-width: 0; }

.node-menu-icon { flex: 0 0 auto; width: 14dp; height: 14dp; image-color: #fafafa66; }

.node-menu-search { flex: 1 1 0; min-width: 0; }

.node-menu-title { flex: 0 0 auto; padding: 2dp 8dp 0 8dp; font-size: 11dp; color: #fafafa66; }

.node-menu-list { flex: 1 1 auto; min-height: 0; overflow-y: auto; }

.node-menu-item { display: flex; align-items: center; gap: 8dp; height: 26dp; padding: 0 8dp; border-radius: 6dp; color: #fafafacc; }

.node-menu-item span { flex: 1 1 auto; min-width: 0; }

.node-menu-item .node-menu-category { flex: 0 1 auto; font-size: 11dp; color: #fafafa59; }

.node-menu-item:hover { background-color: #ffffff0d; color: #fafafa; }

.node-menu-item.active { background-color: #ffffff1a; color: #fafafa; }

.node-menu-arrow { flex: 0 0 auto; width: 8dp; height: 8dp; image-color: #fafafa66; }

.node-menu-empty { padding: 6dp 8dp; font-size: 11dp; color: #fafafa4d; }

.node-status { flex: 0 0 auto; display: flex; align-items: center; height: 24dp; padding: 0 10dp; border-radius: 6dp; background-color: #161616; font-size: 11dp; color: #fafafab3; }

.node-status-text { flex: 1 1 0; min-width: 0; }

.node-status-text.dim { color: #fafafa4d; }

.node-status.error { background-color: #ff646726; color: #ff8a8c; }

.node-status.warning { background-color: #f5c45126; color: #f5c451; }

.node-pane { flex: 0 0 300dp; min-width: 0; padding: 0 4dp 0 8dp; box-sizing: border-box; }

.node-pane-empty { padding-top: 40dp; font-size: 12dp; text-align: center; color: #fafafa4d; }

.node-pane-body { display: flex; flex-direction: column; gap: 6dp; padding-bottom: 16dp; font-size: 12dp; color: #fafafa; }

.node-pane-type { font-size: 11dp; color: #fafafa59; }

.node-pane-section { margin-top: 12dp; padding-bottom: 4dp; border-bottom-width: 1dp; border-color: #ffffff0f; font-size: 12dp; color: #fafafa; }

.node-setting { display: flex; flex-direction: column; gap: 6dp; }

.node-setting > .num { flex: 0 0 auto; }

.node-ramp, .node-curve { display: flex; flex-direction: column; gap: 6dp; }

.node-ramp-bar { height: 20dp; border-width: 1dp; border-color: #ffffff17; border-radius: 4dp; }

.node-ramp-stop, .node-curve-point { display: flex; align-items: center; gap: 6dp; }

.node-ramp-stop .node-swatch { flex: 0 0 28dp; height: 24dp; }

.node-ramp-stop .num, .node-curve-point .num, .node-pane-vector .num { height: 26dp; padding: 0 8dp; border-radius: 6dp; }

.node-row-remove { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 24dp; height: 24dp; border-radius: 6dp; }

.node-row-remove svg { width: 12dp; height: 12dp; image-color: #fafafa80; }

.node-row-remove:hover { background-color: #ffffff0d; }

.node-row-remove:hover svg { image-color: #ff6467; }

.button.node-row-add { align-self: flex-start; height: 26dp; padding: 0 10dp; gap: 6dp; font-size: 12dp; }

.node-row-add svg { width: 12dp; height: 12dp; }

.node-pane-input { display: flex; flex-direction: column; gap: 4dp; }

.node-pane-row { display: flex; align-items: center; gap: 8dp; min-height: 28dp; }

.node-pane-row .node-socket { position: relative; left: 0; top: 0; flex: 0 0 auto; }

.node-pane-name { flex: 0 1 110dp; min-width: 0; color: #fafafab3; }

.node-pane-row .num, .node-pane-row .node-swatch { flex: 1 1 0; }

.node-swatch.wide { height: 24dp; border-radius: 6dp; }

.node-pane-vector { display: flex; gap: 4dp; padding-left: 18dp; }

/*! The nodes badge of a node material tile. */
.material-tile { position: relative; }

.material-nodes { position: absolute; top: 6dp; right: 6dp; width: 14dp; height: 14dp; image-color: #fafafa80; }

/*! Object manager and attribute manager */

.object-manager { flex: 0 0 470dp; display: flex; flex-direction: column; min-height: 0; border-width: 1dp; border-color: #fafafa08; border-radius: 14dp; background-color: #0f0f0f; }

.object-manager > .small-menu { margin: 16dp 16dp 0 20dp; }

.object-rows { flex: 1 1 0; min-height: 60dp; display: flex; flex-direction: column; gap: 2dp; padding: 12dp 12dp 8dp 12dp; }

.object-row { drag: clone; flex: 0 0 auto; display: flex; align-items: center; gap: 0; height: 28dp; padding: 0 8dp; border-radius: 6dp; color: #fafafa; }

.object-row:hover { background-color: #fafafa08; }

.object-row.active, .object-row.active:hover { background-color: #1d1d1d; }

.object-row.drop { background-color: #ffffff0d; }

.object-row.drop-before { border-top-width: 2dp; border-top-color: #e5e5e5; }

.object-row.drop-after { border-bottom-width: 2dp; border-bottom-color: #e5e5e5; }

.object-fold { flex: 0 0 auto; width: 16dp; height: 16dp; margin-right: 4dp; }

.object-fold svg { width: 16dp; height: 16dp; opacity: 0.6; }

.object-fold svg:hover { opacity: 1; }

.object-fold svg.collapsed { transform: rotate(-90deg); }

.material-tag { width: 16dp; height: 16dp; border-radius: 8dp; margin-left: 8dp; }

.material-slots { flex: 0 0 auto; display: flex; align-items: center; gap: 2dp; margin-left: 6dp; }

.material-slot { display: flex; padding: 1dp; border-radius: 10dp; }

.material-slot .material-tag { margin-left: 0; drag: clone; }

.material-slot.drop { background-color: #e5e5e5; }

.material-tag.empty { drag: none; box-sizing: border-box; border-width: 1dp; border-color: #fafafa4d; background-color: transparent; decorator: none; }

.material-link { flex: 1 1 0; min-width: 0; display: flex; align-items: center; gap: 8dp; height: 28dp; padding: 0 10dp 0 6dp; border-radius: 6dp; background-color: #1d1d1d; font-size: 12dp; color: #fafafa; }

.material-link:hover { background-color: #ffffff0f; }

.material-link.empty, .material-link.empty:hover { box-sizing: border-box; background-color: transparent; border-width: 1dp; border-color: #ffffff0f; color: #a1a1a1; }

.material-link .material-tag { margin-left: 0; }

.material-link span { flex: 1 1 0; min-width: 0; }

.attr-hint { margin-top: 4dp; font-size: 11dp; color: #fafafa59; }

.object-icon { flex: 0 0 auto; width: 16dp; height: 16dp; margin-right: 8dp; }

.object-name { flex: 1 1 0; min-width: 0; font-size: 12dp; }

.object-row.active .object-name { color: #fafafa; }

.object-badge { flex: 0 0 auto; margin-left: 8dp; padding: 1dp 6dp; border-radius: 4dp; font-size: 11dp; color: #fafafa; background-color: #ffffff0d; }

.attribute-manager { flex: 1.3 1 0; min-height: 200dp; display: flex; flex-direction: column; border-top-width: 1dp; border-top-color: #fafafa08; }

.attr-header { flex: 0 0 auto; display: flex; align-items: center; gap: 12dp; height: 56dp; padding: 0 16dp 0 20dp; }

.attr-title { flex: 1 1 0; min-width: 0; display: flex; align-items: center; font-size: 13dp; }

.attr-header .tabs { flex: 0 0 auto; height: 32dp; padding: 0 4dp; gap: 0; box-sizing: border-box; border-width: 1dp; border-color: #ffffff0f; border-radius: 8dp; background-color: #0f0f0f; }

.attr-header .tab { height: 30dp; padding: 0 10dp; font-size: 12dp; }

.attributes-body { flex: 1 1 0; min-height: 0; padding: 8dp 16dp 20dp 20dp; }

.attributes-body > div { display: flex; flex-direction: column; gap: 24dp; }

/*! Attribute rows */

.attr-section { display: flex; flex-direction: column; gap: 8dp; }

.attr-heading { display: flex; align-items: center; gap: 12dp; height: 20dp; font-size: 12dp; font-weight: 600; color: #fafafa; }

.attr-subheading { margin-top: 4dp; font-size: 11dp; font-weight: 600; color: #a1a1a1; }

.attr-rule { flex: 1 1 0; height: 1dp; background-color: #fafafa0d; }

.attr-row { display: flex; align-items: center; gap: 12dp; min-height: 28dp; }

.attr-label { flex: 0 0 104dp; font-size: 12dp; color: #fafafa; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.attr-control { flex: 1 1 0; min-width: 0; display: flex; align-items: center; gap: 8dp; }

.attr-control > span.text-secondary { padding-left: 11dp; }

.attr-control select, .attr-control .input, .attr-control .segment { flex: 1 1 0; min-width: 0; }

.attr-note { font-size: 11dp; color: #fafafa59; }

/*! Coordinates: Position, Scale and Rotation side by side, each axis with a key dot */

.coord-grid { display: flex; gap: 12dp; }

.coord-column { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 8dp; }

.coord-title { height: 20dp; padding-left: 36dp; font-size: 12dp; color: #fafafa; text-align: center; }

.coord-row { display: flex; align-items: center; gap: 6dp; }

.key-dot { flex: 0 0 auto; width: 14dp; height: 14dp; border-radius: 7dp; background-color: #fafafa26; decorator: radial-gradient(circle closest-side, #fafafa 46%, transparent 50%); }

.axis-label { flex: 0 0 10dp; font-size: 12dp; text-align: center; color: #fafafa; }

.axis-label.r { color: #ff6b6b; }

.axis-label.g { color: #5fd38a; }

.axis-label.b { color: #4a93ff; }

.vector-row { display: flex; gap: 6dp; flex: 1 1 0; min-width: 0; }

.num-up { decorator: svg(/UI/Icons/chevron-up.svg); opacity: 0.9; }

.num-down { decorator: svg(/UI/Icons/chevron-down.svg); opacity: 0.9; }

.num-up:hover, .num-down:hover { opacity: 1; }

/*! Floating panels, moved by their grip */

.floating { position: absolute; z-index: 20; display: flex; flex-direction: column; border-width: 1dp; border-color: #fafafa0d; border-radius: 14dp; background-color: #0f0f0ff7; box-shadow: #000000a6 0 18dp 48dp 0; }

.float-header { flex: 0 0 auto; display: flex; align-items: center; gap: 16dp; height: 48dp; padding: 0 16dp 0 20dp; }

.float-handle { display: flex; align-items: center; height: 28dp; padding-right: 4dp; cursor: move; }

.float-title { flex: 0 0 auto; max-width: 220dp; font-size: 13dp; color: #fafafa; }

.float-title-wrap { display: flex; min-width: 0; }

.float-arrow { display: flex; align-items: center; justify-content: center; width: 16dp; height: 20dp; }

.float-arrow svg { width: 7dp; height: 11dp; }

.float-lock { width: 11dp; height: 12dp; }

.float-body { flex: 1 1 0; min-height: 0; display: flex; flex-direction: column; overflow: hidden; padding: 20dp 24dp 0 24dp; }

.float-footer { flex: 0 0 auto; display: flex; align-items: center; gap: 16dp; padding: 16dp 24dp 24dp 24dp; }

.float-footer .footer-link { margin-left: auto; font-size: 12dp; color: #fafafa4d; }

.float-footer .button { height: 28dp; padding: 0 12dp; font-size: 12dp; }

.float-empty { padding: 16dp 0; font-size: 12dp; color: #fafafa59; }

.button.dim { color: #fafafab3; }

body.tool-window-body { border-width: 1dp; border-color: #ffffff0f; border-radius: 14dp; background-color: #0f0f0f; }

body.tool-window-body.window-maximized { border-width: 0; border-radius: 0; }

.tool-window { flex: 1 1 0; min-height: 0; display: flex; flex-direction: column; }

.tool-window .float-header { position: relative; height: 56dp; padding: 0 16dp 0 20dp; gap: 16dp; border-bottom-width: 1dp; border-color: #ffffff0f; border-radius: 14dp 14dp 0 0; background-color: #0f0f0f; }

.tool-window .float-title { font-size: 13dp; color: #fafafa; pointer-events: none; }

.tool-window .float-handle { pointer-events: none; }

.tool-window .float-header .window-buttons { position: relative; }

.tool-window .float-arrow svg { image-color: #fafafa80; }

.tool-window .float-arrow:hover svg { image-color: #fafafa; }

.tool-window .float-lock { image-color: #fafafa80; }

.tool-window .window-buttons.start { margin-left: -8dp; }

.tool-window .window-buttons.end { margin: 0 -8dp 0 auto; }

.tool-window .window-buttons.windows.end { margin: 0 -20dp 0 auto; }

.tool-window .window-buttons.windows .title-button.close { border-top-right-radius: 16dp; }

.tool-window .empty-state { flex: 1 1 0; min-height: 0; gap: 12dp; }

.material-columns { flex: 1 1 0; min-height: 0; display: flex; gap: 24dp; }

.material-left { flex: 0 0 136dp; min-height: 0; display: flex; flex-direction: column; }

.material-preview-frame { flex: 0 0 auto; display: flex; justify-content: center; padding: 0 0 16dp 0; }

.name-field { flex: 0 0 auto; height: 28dp; padding: 0 10dp; font-size: 12dp; }

.material-left .attr-row { margin-top: 12dp; gap: 12dp; }

.material-left .combo { min-width: 0; height: 28dp; }

.type-label { flex: 0 0 auto; font-size: 12dp; }

.channel-list { flex: 1 1 0; min-height: 0; display: flex; flex-direction: column; gap: 2dp; margin-top: 16dp; }

.channel { flex: 0 0 auto; display: flex; align-items: center; gap: 12dp; height: 28dp; margin-right: 8dp; padding: 0 8dp; border-radius: 6dp; font-size: 12dp; color: #fafafab3; cursor: pointer; }

.channel:hover { background-color: #ffffff0d; color: #fafafa; }

.channel.selected { background-color: #1d1d1d; color: #fafafa; }

.channel span { flex: 1 1 0; min-width: 0; }

.channel-texture { flex: 0 0 auto; width: 12dp; height: 12dp; image-color: #e5e5e5; }

.material-right { flex: 1 1 0; min-width: 0; min-height: 0; display: flex; flex-direction: column; gap: 24dp; padding: 16dp 0 8dp 0; }

.param { display: flex; flex-direction: column; gap: 16dp; }

.param-head { display: flex; align-items: center; gap: 12dp; height: 28dp; font-size: 12dp; }

.param-head span { flex: 1 1 0; min-width: 0; }

.swatch { flex: 0 0 auto; width: 48dp; height: 22dp; border-radius: 4dp; background-color: #fafafa; }

.swatch-arrow { flex: 0 0 auto; width: 9dp; height: 5dp; margin-left: -2dp; image-color: #fafafacc; }

.swatch-button { display: flex; align-items: center; gap: 8dp; padding: 3dp; border-radius: 6dp; }

.swatch-button:hover, .swatch-button.open { background-color: #ffffff0d; }

.param color-picker, .picker-row color-picker { width: auto; margin: 8dp 0 4dp 0; }

.picker-row { display: block; }

.param-rows { display: flex; flex-direction: column; gap: 12dp; }

.slider-row { display: flex; align-items: center; gap: 12dp; height: 28dp; }

.param-option { display: flex; align-items: center; gap: 12dp; }

.param-option select { flex: 1 1 0; min-width: 0; }

.texture-block { display: flex; flex-direction: column; gap: 8dp; padding-top: 16dp; border-top-width: 1dp; border-top-color: #fafafa0d; }

.texture-row { display: flex; align-items: center; gap: 8dp; }

.texture-pick { flex: 1 1 0; min-width: 0; display: flex; align-items: center; gap: 8dp; height: 28dp; padding: 0 10dp; box-sizing: border-box; border-width: 1dp; border-color: #ffffff17; border-radius: 8dp; background-color: #ffffff05; font-size: 12dp; color: #fafafa; }

.texture-pick:hover, .texture-clear:hover { background-color: #ffffff0d; }

.texture-pick span { flex: 1 1 0; min-width: 0; }

.texture-icon { flex: 0 0 auto; width: 14dp; height: 14dp; image-color: #fafafab3; }

.texture-clear { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 28dp; height: 28dp; box-sizing: border-box; border-width: 1dp; border-color: #ffffff17; border-radius: 8dp; background-color: #ffffff05; }

.texture-clear svg { width: 12dp; height: 12dp; image-color: #fafafab3; }

.texture-hint { font-size: 11dp; color: #fafafa59; }

.slider-num { flex: 0 0 52dp; height: 28dp; padding: 0 0 0 8dp; font-size: 12dp; }

.slider-num .num-unit { margin-left: 2dp; font-size: 12dp; color: #fafafa; }

.slider-num .num-spin { display: none; }

.slider { position: relative; flex: 1 1 0; height: 13dp; border-radius: 1dp; background-color: #ffffff17; cursor: pointer; }

.slider-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 1dp; background-color: #fafafa; pointer-events: none; }

.slider.hue { decorator: linear-gradient(to right, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff); }

.slider.value { decorator: horizontal-gradient(#000000 #fafafa); }

.slider-thumb { position: absolute; top: -6dp; width: 2dp; height: 25dp; margin-left: -1dp; background-color: #fafafa; pointer-events: none; box-shadow: #00000080 0 0 4dp 0; }

/*! View gizmo */

.view-gizmo { position: absolute; top: 80dp; right: 80dp; width: 0; height: 0; pointer-events: none; }

.gizmo-rotor { position: absolute; left: 0; top: 0; width: 0; height: 0; pointer-events: none; }

.gizmo-center { position: absolute; left: -64dp; top: -64dp; width: 128dp; height: 128dp; border-radius: 64dp; pointer-events: auto; }

.gizmo-center:hover { background-color: #fafafa14; }

.gizmo-spoke { position: absolute; left: 0; top: -1dp; width: 51dp; height: 2dp; transform-origin: 0 50% 0; pointer-events: none; }

.gizmo-axis {
    position: absolute;
    box-sizing: border-box;
    left: -11dp;
    top: -11dp;
    width: 22dp;
    height: 22dp;
    border-radius: 11dp;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11dp;
    font-weight: 600;
    line-height: 1;
    color: #0a0a0a;
    pointer-events: auto;
}

.gizmo-neg { border-width: 1.5dp; }

.gizmo-axis.behind { pointer-events: none; }

.gizmo-ring { position: absolute; left: -4dp; top: -4dp; width: 30dp; height: 30dp; box-sizing: border-box; border-width: 1.5dp; border-radius: 15dp; border-color: transparent; pointer-events: none; }

.gizmo-axis:hover .gizmo-ring { border-color: #fafafacc; }

/*! The ring is placed from inside the border, so a negative handle's border would push it off centre. */
.gizmo-neg .gizmo-ring { left: -5.5dp; top: -5.5dp; }

.gizmo-label { display: block; white-space: nowrap; pointer-events: none; }

.spoke-x { background-color: #e93e55; }

.spoke-y { background-color: #8cce28; }

.spoke-z { background-color: #319bf9; }

.gizmo-x { background-color: #e93e55; }

.gizmo-y { background-color: #8cce28; }

.gizmo-z { background-color: #319bf9; }

.gizmo-x.gizmo-neg { background-color: #3a1016d9; border-color: #e93e55; }

.gizmo-y.gizmo-neg { background-color: #23330ad9; border-color: #8cce28; }

.gizmo-z.gizmo-neg { background-color: #0c263ed9; border-color: #319bf9; }

.gizmo-spoke.order-0 { z-index: 1; }
.gizmo-axis.order-0 { z-index: 2; }
.gizmo-spoke.order-1 { z-index: 3; }
.gizmo-axis.order-1 { z-index: 4; }
.gizmo-spoke.order-2 { z-index: 5; }
.gizmo-axis.order-2 { z-index: 6; }
.gizmo-spoke.order-3 { z-index: 7; }
.gizmo-axis.order-3 { z-index: 8; }
.gizmo-spoke.order-4 { z-index: 9; }
.gizmo-axis.order-4 { z-index: 10; }
.gizmo-spoke.order-5 { z-index: 11; }
.gizmo-axis.order-5 { z-index: 12; }

/*! The right edge of the tools lines up with the circle of the view gizmo: its centre is 80dp in and its radius 64dp. */
.view-tools { position: absolute; top: 158dp; right: 16dp; display: flex; flex-direction: column; gap: 8dp; }

.view-tool { display: flex; align-items: center; justify-content: center; width: 32dp; height: 32dp; border-radius: 8dp; background-color: #0a0a0acc; pointer-events: auto; }

.view-tool svg { image-color: #e5e5e5; }

.view-tool:hover { background-color: #ffffff0f; }

.view-tool:hover svg { image-color: #fafafa; }

/*! Training */

.training-grid { display: flex; gap: 12dp; flex: 1 1 0; min-height: 0; }

.training-grid .panel { flex: 1 1 0; }

.field-stack { display: flex; flex-direction: column; gap: 8dp; padding: 4dp 16dp 16dp 16dp; }

.loss-panel .panel-body { padding: 4dp 16dp 16dp 16dp; }

.loss-curve { display: flex; align-items: flex-end; gap: 1dp; height: 220dp; }

.loss-bar { flex: 1 1 0; min-height: 1dp; background-color: #e5e5e5; }
