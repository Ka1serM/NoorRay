{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 29,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}"
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "description": "llvm-mingw: Clang, libc++ and LLD for Windows, from a Windows or Linux host. Its bin folder is in PATH. A Windows host also needs MSYS2's usr\\bin in PATH.",
      "cacheVariables": {
        "PLATFORM": "Windows",
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "AMD64",
        "CMAKE_C_COMPILER": "x86_64-w64-mingw32-clang",
        "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-clang++",
        "CMAKE_RC_COMPILER": "x86_64-w64-mingw32-windres"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "description": "Clang with libc++ and LLD.",
      "cacheVariables": {
        "PLATFORM": "Linux",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "web",
      "hidden": true,
      "inherits": "base",
      "description": "Emscripten for a browser. The first configure installs it into RmlKit's emsdk submodule.",
      "cacheVariables": {
        "PLATFORM": "Web"
      }
    },
    {
      "name": "webgpu",
      "hidden": true,
      "description": "Dawn on the desktop: the WebGPU path of the browser build.",
      "cacheVariables": {
        "NOORRHI_BACKEND": "WebGpu"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "relwithdebinfo",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "inherits": [
        "windows",
        "debug"
      ]
    },
    {
      "name": "windows-relwithdebinfo",
      "displayName": "Windows RelWithDebInfo",
      "inherits": [
        "windows",
        "relwithdebinfo"
      ]
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "inherits": [
        "windows",
        "release"
      ]
    },
    {
      "name": "windows-webgpu-debug",
      "displayName": "Windows WebGPU Debug",
      "inherits": [
        "windows",
        "webgpu",
        "debug"
      ]
    },
    {
      "name": "windows-webgpu-relwithdebinfo",
      "displayName": "Windows WebGPU RelWithDebInfo",
      "inherits": [
        "windows",
        "webgpu",
        "relwithdebinfo"
      ]
    },
    {
      "name": "windows-webgpu-release",
      "displayName": "Windows WebGPU Release",
      "inherits": [
        "windows",
        "webgpu",
        "release"
      ]
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "inherits": [
        "linux",
        "debug"
      ]
    },
    {
      "name": "linux-relwithdebinfo",
      "displayName": "Linux RelWithDebInfo",
      "inherits": [
        "linux",
        "relwithdebinfo"
      ]
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": [
        "linux",
        "release"
      ]
    },
    {
      "name": "linux-portable-release",
      "displayName": "Linux Portable Release",
      "description": "The Python module for the Blender extension zip, built against glibc 2.28 in the container of tools/build_portable_linux.sh.",
      "inherits": [
        "linux",
        "release"
      ],
      "cacheVariables": {
        "NOORRAY_BUILD_APP": "OFF",
        "NOORRAY_BUILD_RECONSTRUCTION": "OFF",
        "Python_EXECUTABLE": "/opt/python/cp311-cp311/bin/python3"
      }
    },
    {
      "name": "linux-webgpu-debug",
      "displayName": "Linux WebGPU Debug",
      "inherits": [
        "linux",
        "webgpu",
        "debug"
      ]
    },
    {
      "name": "linux-webgpu-relwithdebinfo",
      "displayName": "Linux WebGPU RelWithDebInfo",
      "inherits": [
        "linux",
        "webgpu",
        "relwithdebinfo"
      ]
    },
    {
      "name": "linux-webgpu-release",
      "displayName": "Linux WebGPU Release",
      "inherits": [
        "linux",
        "webgpu",
        "release"
      ]
    },
    {
      "name": "web-debug",
      "displayName": "Web Debug",
      "inherits": [
        "web",
        "debug"
      ]
    },
    {
      "name": "web-relwithdebinfo",
      "displayName": "Web RelWithDebInfo",
      "inherits": [
        "web",
        "relwithdebinfo"
      ]
    },
    {
      "name": "web-release",
      "displayName": "Web Release",
      "inherits": [
        "web",
        "release"
      ]
    }
  ],
