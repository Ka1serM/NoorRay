<template name="inspector-render">
<head>
</head>
<body>
    <div class="attr-row" data-if="renderSettings.mode == 'raster'"><p class="attr-label"></p><p class="attr-note">The viewport shows the raster preview; Render, Path traced turns these settings on.</p></div>
    <div class="attr-section" data-if="renderSettings.mode == 'pathTraced'">
        <div class="attr-heading"><span>Sampling</span><div class="attr-rule"></div></div>
        <div class="attr-row"><p class="attr-label">Denoiser</p><div class="attr-control"><select data-value="renderSettings.denoiser" data-event-change="renderSettings.denoiser = ev.value; renderApply()"><option value="off">Off</option><option value="nrd">NRD</option><option value="openDlssRr" data-if="renderSettings.openDlssRrBuilt">OpenDLSS-RR</option></select></div></div>
        <p class="attr-subheading">Viewport</p>
        <div class="attr-row"><p class="attr-label">Max Frames</p><div class="attr-control"><div class="num" step="16" min="0" speed="1" integer><input class="input-field" type="text" data-value="renderSettings.maxFrames" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <p class="attr-subheading">Lights</p>
        <div class="attr-row"><p class="attr-label"></p><label class="toggle"><input type="checkbox" data-checked="renderSettings.lightTree" data-event-change="renderApply()"/><span class="toggle-knob"></span><span>Light Tree</span></label></div>
        <div class="attr-row"><p class="attr-label"></p><label class="toggle"><input type="checkbox" data-checked="renderSettings.visibilityCache" data-event-change="renderApply()"/><span class="toggle-knob"></span><span>Visibility Cache</span></label></div>
        <p class="attr-subheading">Advanced</p>
        <div class="attr-row"><p class="attr-label">Seed</p><div class="attr-control"><div class="num" step="1" min="0" speed="0.1" integer><input class="input-field" type="text" data-value="renderSettings.seed" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
    </div>
    <div class="attr-section" data-if="renderSettings.mode == 'pathTraced'">
        <div class="attr-heading"><span>Realtime</span><div class="attr-rule"></div></div>
        <div class="attr-row"><p class="attr-label"></p><label class="toggle"><input type="checkbox" data-checked="renderSettings.temporal" data-event-change="renderApply()"/><span class="toggle-knob"></span><span>Temporal Reuse</span></label></div>
        <div class="attr-row"><p class="attr-label">ReSTIR</p><div class="attr-control"><select data-value="renderSettings.reuse" data-event-change="renderSettings.reuse = ev.value; renderApply()"><option value="off">Off</option><option value="di">ReSTIR DI</option><option value="pt">ReSTIR PT</option></select></div></div>
        <div class="attr-row"><p class="attr-label"></p><label class="toggle"><input type="checkbox" data-checked="renderSettings.radianceCache" data-event-change="renderApply()"/><span class="toggle-knob"></span><span>Radiance Cache</span></label></div>
        <p class="attr-subheading">Upscaling</p>
        <div class="attr-row" data-if="renderSettings.denoiser == 'openDlssRr'"><p class="attr-label"></p><p class="attr-note">OpenDLSS-RR upscales in place of FSR</p></div>
        <div class="attr-row" data-if="renderSettings.denoiser != 'openDlssRr'"><p class="attr-label"></p><label class="toggle"><input type="checkbox" data-checked="renderSettings.upscale" data-event-change="renderApply()"/><span class="toggle-knob"></span><span>FSR</span></label></div>
        <div class="attr-row"><p class="attr-label">Quality</p><div class="attr-control"><select data-value="renderSettings.upscaleQuality" data-event-change="renderSettings.upscaleQuality = ev.value; renderApply()"><option value="native">Native AA</option><option value="quality">Quality</option><option value="balanced">Balanced</option><option value="performance">Performance</option><option value="ultraPerformance">Ultra Performance</option></select></div></div>
        <div class="attr-row" data-if="renderSettings.denoiser != 'openDlssRr'"><p class="attr-label">Sharpness</p><div class="attr-control"><div class="num" step="0.05" min="0" max="1" speed="0.005"><input class="input-field" type="text" data-value="renderSettings.sharpness" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
    </div>
    <div class="attr-section" data-if="renderSettings.mode == 'pathTraced'">
        <div class="attr-heading"><span>Light Paths</span><div class="attr-rule"></div></div>
        <p class="attr-subheading">Max Bounces</p>
        <div class="attr-row"><p class="attr-label">Total</p><div class="attr-control"><div class="num" step="1" min="0" max="1024" speed="0.1" integer><input class="input-field" type="text" data-value="renderSettings.maxBounces" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row"><p class="attr-label">Diffuse</p><div class="attr-control"><div class="num" step="1" min="0" max="1024" speed="0.1" integer><input class="input-field" type="text" data-value="renderSettings.diffuseBounces" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row"><p class="attr-label">Glossy</p><div class="attr-control"><div class="num" step="1" min="0" max="1024" speed="0.1" integer><input class="input-field" type="text" data-value="renderSettings.glossyBounces" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row"><p class="attr-label">Transmission</p><div class="attr-control"><div class="num" step="1" min="0" max="1024" speed="0.1" integer><input class="input-field" type="text" data-value="renderSettings.transmissionBounces" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row"><p class="attr-label">Volume</p><div class="attr-control"><div class="num" step="1" min="0" max="1024" speed="0.1" integer><input class="input-field" type="text" data-value="renderSettings.volumeBounces" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row"><p class="attr-label">Transparent</p><div class="attr-control"><div class="num" step="1" min="0" max="1024" speed="0.1" integer><input class="input-field" type="text" data-value="renderSettings.transparentBounces" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <p class="attr-subheading">Clamping</p>
        <div class="attr-row"><p class="attr-label">Direct Light</p><div class="attr-control"><div class="num" step="0.5" min="0" speed="0.05"><input class="input-field" type="text" data-value="renderSettings.clampDirect" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row"><p class="attr-label">Indirect Light</p><div class="attr-control"><div class="num" step="0.5" min="0" speed="0.05"><input class="input-field" type="text" data-value="renderSettings.clampIndirect" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <p class="attr-subheading">Caustics</p>
        <div class="attr-row"><p class="attr-label">Filter Glossy</p><div class="attr-control"><div class="num" step="0.1" min="0" max="10" speed="0.01"><input class="input-field" type="text" data-value="renderSettings.filterGlossy" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <p class="attr-subheading" data-if="renderSettings.gaussianTracingBuilt">Gaussians</p>
        <div class="attr-row" data-if="renderSettings.gaussianTracingBuilt"><p class="attr-label">Shading</p><div class="attr-control"><select data-value="renderSettings.gaussianShading" data-event-change="renderSettings.gaussianShading = ev.value; renderApply()"><option value="off">Off</option><option value="emissive">Emissive</option><option value="scattering">Scattering</option></select></div></div>
    </div>
    <div class="attr-section" data-if="renderSettings.mode == 'pathTraced'">
        <div class="attr-heading"><span>Film</span><div class="attr-rule"></div></div>
        <div class="attr-row"><p class="attr-label">Exposure</p><div class="attr-control"><div class="num" step="0.1" min="0" max="10" speed="0.01"><input class="input-field" type="text" data-value="renderSettings.filmExposure" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
        <div class="attr-row"><p class="attr-label">Pixel Filter</p><div class="attr-control"><div class="num" step="0.1" min="0.01" max="10" speed="0.01"><input class="input-field" type="text" data-value="renderSettings.pixelFilter" data-event-change="renderApply()"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div></div></div>
    </div>
</body>
</template>
