    "hide": "never"
  },
  {
    "label": "run Blender with hdnoorray debug",
    "command": "HDNOORRAY_DEBUG=1 blender",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "run NoorRay Debug",
