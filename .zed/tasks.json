  {
    "label": "build \u0026 install hdnoorray in Blender",
    "command": "VULKAN_SDK=/home/marcel/Programs/VulkanSDK/current cmake --build build/release --target hdnoorray -j$(nproc) && blender --background --command extension install-file -r user_default build/release/hdnoorray/hdnoorray-blender-5.2.zip",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
