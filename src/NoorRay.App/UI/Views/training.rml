    <div class="view" id="training" nav="training" crumb="Training">
        <div class="page">
            <div class="page-header">
                <div class="page-header-title">
                    <p class="page-title">Gaussian training</p>
                    <p class="page-subtitle">Trains a Gaussian cloud from posed photographs with the differentiable ray tracer.</p>
                </div>
                <div class="page-divider"></div>
                <div class="meta-item">
                    <p class="meta-label"><span>Iteration</span></p>
                    <p class="meta-value">{{ training.iteration }} / {{ training.iterations }}</p>
                </div>
                <div class="meta-item">
                    <p class="meta-label"><span>Loss</span></p>
                    <p class="meta-value">{{ training.loss }}</p>
                </div>
                <div class="meta-item">
                    <p class="meta-label"><span>PSNR</span></p>
                    <p class="meta-value">{{ training.psnr }}</p>
                </div>
                <div class="page-header-actions">
                    <button class="button primary" data-if="!training.running" data-event-click="trainingStart()"><svg class="icon-14" src="/UI/RmlKit/Icons/icon-zap.svg"/><span>Start</span></button>
                    <button class="button danger" data-if="training.running" data-event-click="trainingStop()"><svg class="icon-14" src="/UI/RmlKit/Icons/icon-x.svg"/><span>Stop</span></button>
                </div>
            </div>

            <div class="training-grid">
                <section class="panel">
                    <div class="panel-header"><div class="grip"></div><p class="panel-title">Dataset</p></div>
                    <div class="panel-body field-stack">
                        <div class="field">
                            <p class="field-label">Folder</p>
                            <div class="input">
                                <svg class="icon-16 icon-muted" src="/UI/RmlKit/Icons/icon-folder.svg"/>
                                <span class="input-value mono clip" data-if="training.datasetPath != ''">{{ training.datasetPath }}</span>
                                <span class="input-value text-muted" data-if="training.datasetPath == ''">A COLMAP or transforms.json folder</span>
                                <button class="input-trailing" data-event-click="trainingChooseDataset()"><span>Choose</span></button>
                            </div>
                            <p class="small text-secondary" data-if="training.datasetInfo != ''">{{ training.datasetInfo }}</p>
                        </div>
                        <div class="field">
                            <p class="field-label">Iterations</p>
                            <div class="num" step="100" speed="10" min="1" integer><input class="input-field" type="text" data-value="training.iterations"/><div class="num-spin"><div class="num-up"></div><div class="num-down"></div></div></div>
                        </div>
                    </div>
                </section>

                <section class="panel loss-panel">
                    <div class="panel-header"><div class="grip"></div><p class="panel-title">Loss</p></div>
                    <div class="panel-body">
                        <div class="empty-state" data-if="training.lossBars.size == 0">
                            <p class="empty-message">The loss curve shows here while the training runs.</p>
                        </div>
                        <div class="loss-curve" data-if="training.lossBars.size > 0">
                            <div class="loss-bar" data-for="bar : training.lossBars" data-style-height="bar.height + '%'"></div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
